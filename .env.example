# Copiar a .env.local y completar con la configuración de tu entorno.
# Públicas: accesibles al navegador y fijadas al construir Next.js.
# Supabase CLI local: http://127.0.0.1:54321; remoto: URL de tu proyecto.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Opcionales: URLs públicas de Etherpad y su middleware externo.
# Desarrollo local: puertos 9001 y 8081; producción: URLs HTTPS accesibles al navegador.
NEXT_PUBLIC_ETHERPAD_URL=
NEXT_PUBLIC_ETHERPAD_MIDDLEWARE_URL=

# Privadas: solo para Edge Functions; nunca usar prefijo NEXT_PUBLIC_.
# Supabase inyecta SUPABASE_URL y SUPABASE_SERVICE_ROLE_KEY en su runtime.
# No reenviar estas variables al frontend ni pasarlas como argumentos Docker.
OPENAI_API_KEY=

# Opcionales: consumidores externos de back/etc/prompts/*.prompty.
AI_INFERENCE_ENDPOINT=
AI_INFERENCE_MODEL=
